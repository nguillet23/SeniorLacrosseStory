---
import BaseLayout from '../layouts/BaseLayout.astro';

const home = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Page not found | XR Lacrosse Goalie Training"
  description="This page does not exist. Return to the XR Lacrosse Goalie Training project site."
  noindex
>
  <main id="main" class="missing theme-chalk">
    <div class="container">
      <p class="code">404</p>
      <h1>Page not found</h1>
      <p>That page is not part of the XR Lacrosse project site.</p>
      <a class="button" href={home}>
        Back to the project
      </a>
    </div>
  </main>
</BaseLayout>

<style>
  .missing {
    display: grid;
    min-height: 100vh;
    align-items: center;
    background: var(--bg);
    color: var(--fg);
  }

  .container {
    display: grid;
    gap: var(--space-4);
    justify-items: start;
  }

  .code {
    font-family: var(--font-display);
    font-size: var(--step-3);
    font-weight: 800;
    color: var(--fg-soft);
  }

  h1 {
    font-size: var(--step-4);
    line-height: 0.9;
    text-transform: uppercase;
  }
</style>
