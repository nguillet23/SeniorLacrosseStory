---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import Section from '../components/Section.astro';
import Trajectory from '../components/Trajectory.astro';
---

<BaseLayout
  title="XR Lacrosse Goalie Training | Villanova Senior Design"
  description="A Villanova senior design project that combines a Magic Leap headset, Unity and a Magic Leap controller to train lacrosse goalies in extended reality."
>
  <Navbar />
  <main id="main">
    <section id="hero" class="hero theme-chalk" aria-labelledby="hero-title">
      <div class="container hero-grid">
        <div class="hero-text">
          <h1 id="hero-title">Extended Reality Lacrosse Goalie Training</h1>
          <p class="hero-sub">Villanova University Senior Design Project</p>
          <p>
            Bridging the gap between traditional training and immersive technology, to build the
            next generation of goalie preparation.
          </p>
          <a class="button" href="#unity">
            Explore the project
          </a>
        </div>
        <Trajectory />
      </div>
    </section>

    <!-- Sample sections: confirm both themes render. Real content arrives in Phase 4. -->
    <Section id="unity" title="Development environment" lead="Building with Unity and Magic Leap">
      <div class="split">
        <div class="stack">
          <h3>Unity engine and Magic Leap integration</h3>
          <p class="placeholder">
            [Your explanation of how you chose Unity for development, Magic Leap device selection,
            initial prototyping approach, and key challenges overcome]
          </p>
        </div>
        <div
          class="media-placeholder"
          role="img"
          aria-label="Placeholder for development screenshots"
        >
          <span>Development screenshots</span>
        </div>
      </div>
      <ul class="features">
        <li>
          <h3>Magic Leap device</h3>
          <p class="placeholder">[Technical specs, advantages, challenges]</p>
        </li>
        <li>
          <h3>Unity development</h3>
          <p class="placeholder">
            [Unity version, plugins, custom scripts, performance optimization]
          </p>
        </li>
        <li>
          <h3>Game engine features</h3>
          <p class="placeholder">[Rendering pipeline, physics, tracking, UI systems]</p>
        </li>
      </ul>
    </Section>

    <Section
      id="hardware"
      variant="turf"
      title="Hardware integration"
      lead="The Magic Leap headset and controller"
    >
      <dl class="specs">
        <div>
          <dt>Tracking accuracy</dt>
          <dd>XX mm</dd>
        </div>
        <div>
          <dt>Refresh rate</dt>
          <dd>XX Hz</dd>
        </div>
        <div>
          <dt>Latency</dt>
          <dd>XX ms</dd>
        </div>
        <div>
          <dt>Battery life</dt>
          <dd>XX h</dd>
        </div>
      </dl>
      <a class="button" href="#unity">
        Back to Unity
      </a>
    </Section>
  </main>
  <Footer />
</BaseLayout>

<style>
  .hero {
    padding-block: var(--space-6) var(--space-7);
    background: var(--bg);
    color: var(--fg);
  }

  .hero-grid {
    display: grid;
    gap: var(--space-6);
    align-items: center;
  }

  .hero-text {
    display: grid;
    gap: var(--space-4);
    justify-items: start;
  }

  h1 {
    font-size: var(--step-4);
    line-height: 0.9;
    text-transform: uppercase;
  }

  .hero-sub {
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: 700;
    color: var(--fg-soft);
  }

  .split {
    display: grid;
    gap: var(--space-5);
    align-items: start;
    margin-bottom: var(--space-6);
  }

  .stack {
    display: grid;
    gap: var(--space-3);
  }

  h3 {
    font-size: var(--step-2);
  }

  .media-placeholder {
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 9;
    border: 2px dashed var(--net);
    border-radius: var(--radius-sm);
    color: var(--fg-soft);
  }

  .features {
    display: grid;
    gap: var(--space-5);
  }

  .features li {
    display: grid;
    gap: var(--space-2);
    padding-top: var(--space-3);
    border-top: 2px solid var(--fg);
  }

  .features h3 {
    font-size: var(--step-1);
  }

  .specs {
    display: grid;
    gap: var(--space-5) var(--space-4);
    grid-template-columns: repeat(2, 1fr);
    margin: 0 0 var(--space-6);
  }

  .specs dd {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--step-3);
    font-weight: 800;
    line-height: 0.9;
    white-space: nowrap;
  }

  .specs dt {
    margin-top: var(--space-2);
    color: var(--fg-soft);
  }

  .specs div {
    display: flex;
    flex-direction: column-reverse;
  }

  @media (min-width: 56rem) {
    .hero-grid {
      grid-template-columns: 1.1fr 1fr;
    }

    .split {
      grid-template-columns: 1fr 1fr;
    }

    .features {
      grid-template-columns: repeat(3, 1fr);
    }

    .specs {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
