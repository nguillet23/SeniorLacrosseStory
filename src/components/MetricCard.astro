---
// A test result: big number, what it measures, and a note in the default slot.
interface Props {
  value: string;
  label: string;
}

const { value, label } = Astro.props;
---

<article class="metric">
  <p class="value">
    <span aria-hidden="true" data-metric-value>
      {value}
    </span>
    <span class="visually-hidden">{value}</span>
  </p>
  <p class="label">{label}</p>
  <div class="note">
    <slot />
  </div>
</article>

<style>
  .metric {
    display: grid;
    gap: var(--space-2);
    align-content: start;
    padding-top: var(--space-3);
    border-top: 2px solid var(--fg);
  }

  .value {
    font-family: var(--font-display);
    font-size: var(--step-4);
    font-weight: 800;
    line-height: 0.9;
    white-space: nowrap;
  }

  .label {
    font-weight: 700;
  }

  .note {
    color: var(--fg-soft);
  }
</style>

<script>
  import '../scripts/counters';
</script>
