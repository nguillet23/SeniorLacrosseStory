---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  name: string;
  position: string;
  photo?: ImageMetadata;
}

const { name, position, photo } = Astro.props;
const initials = name
  .split(/\s+/)
  .map((part) => part[0])
  .join('')
  .slice(0, 2);
---

<article class="member">
  <div class="photo">
    {photo ? (
      <Image src={photo} alt={`Portrait of ${name}`} widths={[240, 480]} sizes="240px" />
    ) : (
      <span class="initials" aria-hidden="true">
        {initials}
      </span>
    )}
  </div>
  <h3>{name}</h3>
  <p class="position">{position}</p>
</article>

<style>
  .member {
    display: grid;
    gap: var(--space-2);
    justify-items: start;
  }

  .photo {
    display: grid;
    place-items: center;
    width: min(100%, 15rem);
    aspect-ratio: 4 / 5;
    overflow: hidden;
    margin-bottom: var(--space-2);
    border: 2px solid var(--fg);
    border-radius: var(--radius-sm);
  }

  .photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .initials {
    font-family: var(--font-display);
    font-size: var(--step-4);
    font-weight: 800;
    color: var(--fg-soft);
  }

  h3 {
    font-size: var(--step-2);
  }

  .position {
    color: var(--fg-soft);
  }
</style>
