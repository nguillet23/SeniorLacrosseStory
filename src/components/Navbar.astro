---
import { getCollection } from 'astro:content';

const sections = (await getCollection('sections')).sort((a, b) => a.data.order - b.data.order);
const links = [
  { href: '#hero', label: 'Home' },
  ...sections.map((section) => ({ href: `#${section.id}`, label: section.data.navLabel })),
];
---

<div class="nav-sentinel" data-nav-sentinel aria-hidden="true"></div>
<header class="navbar theme-chalk" data-navbar>
  <div class="container bar">
    <a class="brand" href="#hero">
      XR Goalie
    </a>
    <button
      class="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="site-menu"
      data-menu-toggle
    >
      <span class="visually-hidden">Menu</span>
      <span class="bars" aria-hidden="true"></span>
    </button>
    <nav aria-label="Main">
      <ul id="site-menu" class="menu" data-menu>
        {links.map((link) => (
          <li>
            <a href={link.href}>{link.label}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .navbar {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 94%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid transparent;
    transition: border-color var(--duration-base);
  }

  /* Set by scripts/nav-scroll.ts once the page has scrolled */
  .navbar[data-scrolled] {
    border-bottom-color: var(--rule);
  }

  /* Invisible marker at the top of the page that the scroll observer watches */
  .nav-sentinel {
    position: absolute;
    top: 0;
    left: 0;
    width: 1px;
    height: 5rem;
    pointer-events: none;
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: var(--nav-height);
  }

  .brand {
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: 800;
    text-decoration: none;
    letter-spacing: 0.02em;
  }

  .menu {
    display: flex;
    gap: var(--space-4);
  }

  .menu a {
    display: inline-block;
    padding-block: var(--space-2);
    text-decoration: none;
    font-weight: 600;
    border-bottom: 2px solid transparent;
    transition: border-color var(--duration-fast);
  }

  .menu a:hover,
  .menu a[aria-current='true'] {
    border-bottom-color: var(--ball);
  }

  .menu-toggle {
    display: none;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    cursor: pointer;
  }

  .bars,
  .bars::before,
  .bars::after {
    display: block;
    width: 1.5rem;
    height: 2px;
    margin-inline: auto;
    background: currentColor;
    transition: transform var(--duration-base) var(--ease);
  }

  .bars::before,
  .bars::after {
    content: '';
    position: relative;
  }

  .bars::before {
    top: -7px;
  }

  .bars::after {
    top: 5px;
  }

  [aria-expanded='true'] .bars {
    background: transparent;
  }

  [aria-expanded='true'] .bars::before {
    transform: translateY(7px) rotate(45deg);
  }

  [aria-expanded='true'] .bars::after {
    transform: translateY(-7px) rotate(-45deg);
  }

  @media (max-width: 52rem) {
    nav {
      display: contents;
    }

    .menu-toggle {
      display: block;
    }

    .menu {
      position: absolute;
      inset: var(--nav-height) 0 auto 0;
      flex-direction: column;
      gap: 0;
      padding: var(--space-2) var(--gutter) var(--space-4);
      background: var(--bg);
      border-bottom: 1px solid var(--rule);
    }

    .menu:not(.open) {
      display: none;
    }

    .menu a {
      display: block;
      padding-block: var(--space-3);
    }
  }
</style>

<script>
  import '../scripts/menu';
  import '../scripts/active-nav';
  import '../scripts/nav-scroll';
</script>
