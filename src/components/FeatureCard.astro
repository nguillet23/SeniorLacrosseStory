---
interface Props {
  title: string;
  level?: 3 | 4;
}

const { title, level = 3 } = Astro.props;
const Heading = `h${level}` as const;
---

<article class="feature">
  <Heading>{title}</Heading>
  <slot />
</article>

<style>
  .feature {
    display: grid;
    gap: var(--space-2);
    align-content: start;
    padding-top: var(--space-3);
    border-top: 2px solid var(--fg);
  }

  .feature :global(:is(h3, h4)) {
    font-size: var(--step-1);
  }
</style>
