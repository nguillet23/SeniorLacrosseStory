---
// A titled block inside a Section (h3 under the section's h2).
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<div class="subsection">
  <h3>{title}</h3>
  <slot />
</div>

<style>
  .subsection {
    display: grid;
    gap: var(--space-4);
    margin-top: var(--space-6);
  }

  h3 {
    font-size: var(--step-2);
  }
</style>
