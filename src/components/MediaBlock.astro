---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { resolveImage } from '../lib/media';

// One component for every kind of media. Text alternatives are required by the types:
// images need `alt`, videos need `label`, embeds need `title`, placeholders need `label`.
interface Base {
  ratio?: string;
  caption?: string;
}

type Props = Base &
  // `src` is a path inside src/assets/images/, for example "unity/gameplay.png"
  (
    | { kind: 'image'; src: ImageMetadata | string; alt: string }
    // `src` and `poster` are paths under public/, for example "videos/demo.mp4"
    | { kind: 'video'; src: string; label: string; poster?: string }
    | { kind: 'embed'; src: string; title: string }
    | { kind: 'placeholder'; label: string; hint?: string }
  );

const props = Astro.props;
const ratio = props.ratio ?? '16 / 9';
const withBase = (path: string) => `${import.meta.env.BASE_URL}${path.replace(/^\//, '')}`;
---

<figure class="media">
  <div class="frame" style={`--ratio: ${ratio}`}>
    {props.kind === 'image' && (
      <Image
        src={typeof props.src === 'string' ? resolveImage(props.src) : props.src}
        alt={props.alt}
        widths={[480, 800, 1200]}
        sizes="(min-width: 72rem) 36rem, 100vw"
      />
    )}
    {props.kind === 'video' && (
      <video
        controls
        muted
        playsinline
        preload="metadata"
        aria-label={props.label}
        src={withBase(props.src)}
        poster={props.poster ? withBase(props.poster) : undefined}
      />
    )}
    {props.kind === 'embed' && (
      <iframe src={props.src} title={props.title} loading="lazy" allowfullscreen />
    )}
    {props.kind === 'placeholder' && (
      <div class="placeholder-box" role="img" aria-label={`Placeholder: ${props.label}`}>
        <span>{props.label}</span>
        {props.hint && <small>{props.hint}</small>}
      </div>
    )}
  </div>
  {props.caption && <figcaption>{props.caption}</figcaption>}
</figure>

<style>
  .media {
    margin: 0;
  }

  .frame {
    aspect-ratio: var(--ratio);
    overflow: hidden;
    border-radius: var(--radius-sm);
  }

  .frame :is(img, video, iframe) {
    width: 100%;
    height: 100%;
    border: 0;
    object-fit: cover;
  }

  .placeholder-box {
    display: grid;
    place-content: center;
    gap: var(--space-1);
    height: 100%;
    border: 2px dashed var(--fg-soft);
    border-radius: var(--radius-sm);
    color: var(--fg-soft);
    text-align: center;
  }

  figcaption {
    margin-top: var(--space-2);
    color: var(--fg-soft);
    font-size: var(--step--1);
  }
</style>
