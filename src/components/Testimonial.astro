---
// A quote from a tester. The default slot holds the quote text.
interface Props {
  author: string;
  position?: string;
}

const { author, position } = Astro.props;
---

<figure class="testimonial">
  <blockquote>
    <slot />
  </blockquote>
  <figcaption>
    <strong>{author}</strong>
    {position && <span>, {position}</span>}
  </figcaption>
</figure>

<style>
  .testimonial {
    display: grid;
    gap: var(--space-3);
    align-content: start;
    margin: 0;
    padding-left: var(--space-4);
    border-left: 4px solid var(--ball);
  }

  blockquote {
    margin: 0;
    font-size: var(--step-1);
    line-height: 1.4;
  }

  figcaption {
    color: var(--fg-soft);
  }

  figcaption strong {
    color: var(--fg);
  }
</style>
