---
interface Props {
  id: string;
  title: string;
  lead?: string;
  variant?: 'chalk' | 'turf';
}

const { id, title, lead, variant = 'chalk' } = Astro.props;
---

<section id={id} class={`section theme-${variant}`} aria-labelledby={`${id}-title`}>
  <div class="container">
    <header class="section-header">
      <h2 id={`${id}-title`}>{title}</h2>
      {lead && <p class="lead">{lead}</p>}
    </header>
    <div class="body">
      <slot />
    </div>
  </div>
</section>

<style>
  .section {
    padding-block: var(--space-7);
    background: var(--bg);
    color: var(--fg);
  }

  .section-header {
    display: grid;
    gap: var(--space-3);
    margin-bottom: var(--space-6);
  }

  .body {
    display: grid;
    gap: var(--space-5);
  }

  h2 {
    font-size: var(--step-3);
  }

  .lead {
    color: var(--fg-soft);
    font-size: var(--step-1);
  }
</style>
