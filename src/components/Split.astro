---
// Text beside media. The default slot is the text; `media` takes the MediaBlock props
// (a prop, not a slot, so it works from MDX).
import type { ComponentProps } from 'astro/types';
import MediaBlock from './MediaBlock.astro';

interface Props {
  media?: ComponentProps<typeof MediaBlock>;
}

const { media } = Astro.props;
---

<div class:list={['split', { 'has-media': media }]}>
  <div class="text">
    <slot />
  </div>
  {media && (
    <div class="media">
      <MediaBlock {...media} />
    </div>
  )}
</div>

<style>
  .split {
    display: grid;
    gap: var(--space-5);
    align-items: start;
  }

  .text {
    display: grid;
    gap: var(--space-3);
  }

  @media (min-width: 56rem) {
    .has-media {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
